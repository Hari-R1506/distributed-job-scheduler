{"openapi":"3.0.0","paths":{"/api/v1/auth/register":{"post":{"operationId":"AuthController_register","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterDto"}}}},"responses":{"201":{"description":""}},"summary":"Create an account and its first organization","tags":["auth"]}},"/api/v1/auth/login":{"post":{"operationId":"AuthController_login","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginDto"}}}},"responses":{"200":{"description":""}},"summary":"Exchange credentials for an access token","tags":["auth"]}},"/api/v1/auth/refresh":{"post":{"operationId":"AuthController_refresh","parameters":[],"responses":{"200":{"description":""}},"summary":"Rotate the refresh token and mint a new access token","tags":["auth"]}},"/api/v1/auth/logout":{"post":{"operationId":"AuthController_logout","parameters":[],"responses":{"204":{"description":""}},"tags":["auth"]}},"/api/v1/auth/me":{"get":{"operationId":"AuthController_me","parameters":[],"responses":{"200":{"description":""}},"summary":"The current principal and its memberships","tags":["auth"]}},"/api/v1/orgs":{"get":{"operationId":"ProjectsController_orgs","parameters":[],"responses":{"200":{"description":""}},"summary":"Organizations the caller belongs to","tags":["projects"]}},"/api/v1/projects":{"get":{"operationId":"ProjectsController_list","parameters":[],"responses":{"200":{"description":""}},"tags":["projects"]},"post":{"operationId":"ProjectsController_create","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateProjectDto"}}}},"responses":{"201":{"description":""}},"tags":["projects"]}},"/api/v1/projects/{projectId}":{"get":{"operationId":"ProjectsController_detail","parameters":[{"name":"projectId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"tags":["projects"]},"patch":{"operationId":"ProjectsController_update","parameters":[{"name":"projectId","required":true,"in":"path","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateProjectDto"}}}},"responses":{"200":{"description":""}},"tags":["projects"]},"delete":{"description":"A soft delete. Hard-deleting would cascade to every job, execution and log — which is exactly the audit trail you want after deciding a project was a mistake.","operationId":"ProjectsController_archive","parameters":[{"name":"projectId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"204":{"description":""}},"summary":"Archive a project","tags":["projects"]}},"/api/v1/projects/{projectId}/retry-policies":{"get":{"operationId":"ProjectsController_policies","parameters":[{"name":"projectId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"tags":["projects"]},"post":{"operationId":"ProjectsController_createPolicy","parameters":[{"name":"projectId","required":true,"in":"path","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateRetryPolicyDto"}}}},"responses":{"201":{"description":""}},"tags":["projects"]}},"/api/v1/retry-policies/{policyId}":{"delete":{"description":"Returns 409 if any queue still references it — the FK is ON DELETE RESTRICT, so this fails loudly rather than leaving queues undefined.","operationId":"ProjectsController_deletePolicy","parameters":[{"name":"policyId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"204":{"description":""}},"summary":"Delete a retry policy","tags":["projects"]}},"/api/v1/projects/{projectId}/api-keys":{"get":{"operationId":"ProjectsController_apiKeys","parameters":[{"name":"projectId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"tags":["projects"]},"post":{"description":"The plaintext key is returned ONCE and never again. Only its SHA-256 is stored.","operationId":"ProjectsController_createApiKey","parameters":[{"name":"projectId","required":true,"in":"path","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateApiKeyDto"}}}},"responses":{"201":{"description":""}},"summary":"Issue an API key","tags":["projects"]}},"/api/v1/api-keys/{keyId}":{"delete":{"operationId":"ProjectsController_revokeApiKey","parameters":[{"name":"keyId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"204":{"description":""}},"tags":["projects"]}},"/api/v1/projects/{projectId}/queues":{"get":{"operationId":"QueuesController_list","parameters":[{"name":"projectId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"summary":"List queues with live health","tags":["queues"]},"post":{"operationId":"QueuesController_create","parameters":[{"name":"projectId","required":true,"in":"path","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateQueueDto"}}}},"responses":{"201":{"description":""}},"summary":"Create a queue","tags":["queues"]}},"/api/v1/queues/{queueId}":{"get":{"operationId":"QueuesController_detail","parameters":[{"name":"queueId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"tags":["queues"]},"patch":{"description":"Changes affect NEW jobs only. Each job snapshots its retry contract at creation, so editing a policy cannot rewrite the behaviour of jobs already in flight.","operationId":"QueuesController_update","parameters":[{"name":"queueId","required":true,"in":"path","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateQueueDto"}}}},"responses":{"200":{"description":""}},"summary":"Update queue configuration","tags":["queues"]},"delete":{"operationId":"QueuesController_remove","parameters":[{"name":"queueId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"204":{"description":""}},"summary":"Delete a queue. Refuses if it still holds jobs unless force=true.","tags":["queues"]}},"/api/v1/queues/{queueId}/pause":{"post":{"description":"Stops new claims. Running jobs are NOT killed — pause means \"stop starting\", not \"abort\", because aborting would leave side effects half-applied.","operationId":"QueuesController_pause","parameters":[{"name":"queueId","required":true,"in":"path","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PauseDto"}}}},"responses":{"200":{"description":""}},"summary":"Pause a queue","tags":["queues"]}},"/api/v1/queues/{queueId}/resume":{"post":{"operationId":"QueuesController_resume","parameters":[{"name":"queueId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"tags":["queues"]}},"/api/v1/queues/{queueId}/stats":{"get":{"operationId":"QueuesController_queueStats","parameters":[{"name":"queueId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"tags":["queues"]}},"/api/v1/handlers":{"get":{"description":"Drives the Create Job form: selecting a handler loads its schema and an example payload, so the UI never hardcodes a handler list.","operationId":"JobsController_listHandlers","parameters":[],"responses":{"200":{"description":""}},"summary":"List available job handlers","tags":["jobs"]}},"/api/v1/queues/{queueId}/jobs":{"post":{"operationId":"JobsController_create","parameters":[{"name":"queueId","required":true,"in":"path","schema":{"type":"string"}},{"name":"Idempotency-Key","in":"header","description":"Makes creation idempotent. A retried request carrying the same key returns the original job with 200 and X-Idempotent-Replay: true, rather than creating a duplicate.","required":false,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateJobDto"}}}},"responses":{"200":{"description":"Idempotent replay of an existing job"},"201":{"description":"Created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobResponse"}}}},"409":{"description":"Queue is paused"},"422":{"description":"Unknown handler, or payload fails its schema"}},"summary":"Create a job","tags":["jobs"]}},"/api/v1/queues/{queueId}/jobs/batch":{"post":{"description":"Returns 207 Multi-Status. Unless stop_on_error is set, valid jobs commit and invalid ones are reported by index.","operationId":"JobsController_createBatch","parameters":[{"name":"queueId","required":true,"in":"path","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateBatchDto"}}}},"responses":{"207":{"description":""}},"summary":"Create up to 1,000 jobs","tags":["jobs"]}},"/api/v1/projects/{projectId}/jobs":{"get":{"operationId":"JobsController_list","parameters":[{"name":"projectId","required":true,"in":"path","schema":{"type":"string"}},{"name":"limit","required":false,"in":"query","schema":{"minimum":1,"maximum":200,"default":50,"type":"number"}},{"name":"cursor","required":false,"in":"query","description":"Opaque cursor from a previous response.","schema":{"type":"string"}},{"name":"queue_id","required":false,"in":"query","schema":{"type":"string"}},{"name":"status","required":false,"in":"query","description":"Repeatable, or comma-separated.","schema":{"example":"DEAD_LETTER,FAILED","allOf":[{"$ref":"#/components/schemas/Object"}]}},{"name":"handler","required":false,"in":"query","schema":{"type":"string"}},{"name":"batch_id","required":false,"in":"query","schema":{"type":"string"}},{"name":"scheduled_job_id","required":false,"in":"query","schema":{"type":"string"}},{"name":"priority_gte","required":false,"in":"query","schema":{"type":"number"}},{"name":"priority_lte","required":false,"in":"query","schema":{"type":"number"}},{"name":"created_after","required":false,"in":"query","schema":{"type":"string"}},{"name":"created_before","required":false,"in":"query","schema":{"type":"string"}},{"name":"search","required":false,"in":"query","description":"Job id prefix.","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"summary":"The job explorer — filtered, cursor-paginated","tags":["jobs"]}},"/api/v1/jobs/{jobId}":{"get":{"description":"Executions are inlined (capped at 20) because the detail page always needs them; the full list is at /jobs/:id/executions.","operationId":"JobsController_detail","parameters":[{"name":"jobId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"summary":"Job detail with its attempt history","tags":["jobs"]}},"/api/v1/jobs/{jobId}/executions":{"get":{"operationId":"JobsController_executions","parameters":[{"name":"jobId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"summary":"Full attempt history","tags":["jobs"]}},"/api/v1/jobs/{jobId}/logs":{"get":{"operationId":"JobsController_logs","parameters":[{"name":"jobId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"summary":"Handler log lines, optionally scoped to one attempt","tags":["jobs"]}},"/api/v1/jobs/{jobId}/cancel":{"post":{"description":"SCHEDULED/QUEUED/RETRYING cancel immediately (200). A RUNNING job is cancelled cooperatively and returns 202 — the handler aborts at its next await point.","operationId":"JobsController_cancel","parameters":[{"name":"jobId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":"Cancelled immediately"},"202":{"description":"RUNNING job — cancellation requested; the handler aborts at its next await point"},"409":{"description":"Job is already terminal"}},"summary":"Cancel a job","tags":["jobs"]}},"/api/v1/jobs/{jobId}/retry":{"post":{"description":"Creates a NEW job with parent_job_id set. The original is never reset, so its execution history survives.","operationId":"JobsController_retry","parameters":[{"name":"jobId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"201":{"description":""}},"summary":"Retry a terminal job","tags":["jobs"]}},"/api/v1/cron/validate":{"post":{"description":"Powers the live preview on the Create Job form. Nobody reads `0 9 * * *` correctly under time pressure.","operationId":"SchedulesController_validateCronExpression","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ValidateCronDto"}}}},"responses":{"200":{"description":""}},"summary":"Validate a cron expression and preview its next runs","tags":["schedules"]}},"/api/v1/projects/{projectId}/scheduled-jobs":{"get":{"operationId":"SchedulesController_list","parameters":[{"name":"projectId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"tags":["schedules"]},"post":{"operationId":"SchedulesController_create","parameters":[{"name":"projectId","required":true,"in":"path","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateScheduleDto"}}}},"responses":{"201":{"description":""}},"tags":["schedules"]}},"/api/v1/scheduled-jobs/{scheduleId}":{"patch":{"description":"Changing the cron expression or timezone recomputes next_run_at from now.","operationId":"SchedulesController_update","parameters":[{"name":"scheduleId","required":true,"in":"path","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateScheduleDto"}}}},"responses":{"200":{"description":""}},"summary":"Update a schedule","tags":["schedules"]},"delete":{"operationId":"SchedulesController_remove","parameters":[{"name":"scheduleId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"204":{"description":""}},"tags":["schedules"]}},"/api/v1/scheduled-jobs/{scheduleId}/pause":{"post":{"operationId":"SchedulesController_pause","parameters":[{"name":"scheduleId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"tags":["schedules"]}},"/api/v1/scheduled-jobs/{scheduleId}/resume":{"post":{"description":"Recomputes next_run_at from now, so resuming does not fire a burst of catch-up jobs for the paused period.","operationId":"SchedulesController_resume","parameters":[{"name":"scheduleId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"summary":"Resume a schedule","tags":["schedules"]}},"/api/v1/scheduled-jobs/{scheduleId}/trigger":{"post":{"description":"Does NOT disturb the cursor — the normal schedule continues unchanged. Invaluable for demos and for on-call.","operationId":"SchedulesController_trigger","parameters":[{"name":"scheduleId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"201":{"description":""}},"summary":"Fire once immediately","tags":["schedules"]}},"/api/v1/scheduled-jobs/{scheduleId}/runs":{"get":{"operationId":"SchedulesController_runs","parameters":[{"name":"scheduleId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"tags":["schedules"]}},"/api/v1/orgs/{orgId}/workers":{"get":{"operationId":"WorkersController_list","parameters":[{"name":"orgId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"summary":"The fleet, with derived health","tags":["workers"]}},"/api/v1/workers/{workerId}":{"get":{"operationId":"WorkersController_detail","parameters":[{"name":"workerId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"tags":["workers"]}},"/api/v1/workers/{workerId}/heartbeats":{"get":{"operationId":"WorkersController_heartbeats","parameters":[{"name":"workerId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"summary":"Sampled history behind the worker charts","tags":["workers"]}},"/api/v1/projects/{projectId}/dlq":{"get":{"operationId":"DlqController_list","parameters":[{"name":"projectId","required":true,"in":"path","schema":{"type":"string"}},{"name":"limit","required":false,"in":"query","schema":{"minimum":1,"maximum":200,"default":50,"type":"number"}},{"name":"cursor","required":false,"in":"query","description":"Opaque cursor from a previous response.","schema":{"type":"string"}},{"name":"resolved","required":false,"in":"query","schema":{"default":"false","type":"string"}},{"name":"queue_id","required":false,"in":"query","schema":{"type":"string"}},{"name":"reason","required":false,"in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"summary":"Triage list — unresolved entries by default","tags":["dlq"]}},"/api/v1/projects/{projectId}/dlq/groups":{"get":{"description":"400 failures are usually 3 problems. Grouping by normalised signature is what turns a table dump into a triage list.","operationId":"DlqController_groups","parameters":[{"name":"projectId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"summary":"Unresolved failures grouped by error signature","tags":["dlq"]}},"/api/v1/dlq/{dlqId}":{"get":{"operationId":"DlqController_detail","parameters":[{"name":"dlqId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"tags":["dlq"]}},"/api/v1/dlq/{dlqId}/replay":{"post":{"description":"Creates a NEW job with parent_job_id set — it never resurrects the original, so the failure history survives. Guarded against double-replay.","operationId":"DlqController_replay","parameters":[{"name":"dlqId","required":true,"in":"path","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReplayDto"}}}},"responses":{"201":{"description":""}},"summary":"Replay a dead-lettered job","tags":["dlq"]}},"/api/v1/dlq/{dlqId}/discard":{"post":{"description":"Removes the entry from triage. The record is kept — DLQ entries are never deleted.","operationId":"DlqController_discard","parameters":[{"name":"dlqId","required":true,"in":"path","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DiscardDto"}}}},"responses":{"200":{"description":""}},"summary":"Accept the loss","tags":["dlq"]}},"/api/v1/projects/{projectId}/metrics/overview":{"get":{"operationId":"MetricsController_overview","parameters":[{"name":"projectId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"summary":"The dashboard stat cards","tags":["metrics"]}},"/api/v1/projects/{projectId}/metrics/throughput":{"get":{"description":"Served from queue_metrics_minute. Answering this from job_executions would aggregate millions of rows on every dashboard poll.","operationId":"MetricsController_throughput","parameters":[{"name":"projectId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"summary":"Time series for the throughput chart","tags":["metrics"]}},"/api/v1/projects/{projectId}/metrics/latency":{"get":{"description":"Queue wait (created -> started) is the user-facing latency and is far more actionable than execution time alone. Measured on first attempts only.","operationId":"MetricsController_latency","parameters":[{"name":"projectId","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":""}},"summary":"Queue wait vs execution time","tags":["metrics"]}},"/health":{"get":{"operationId":"HealthController_health","parameters":[],"responses":{"200":{"description":""}},"summary":"Liveness — the process is up","tags":["health"]}},"/ready":{"get":{"operationId":"HealthController_ready","parameters":[],"responses":{"200":{"description":""}},"summary":"Readiness — database reachable and migrations current","tags":["health"]}}},"info":{"title":"Distributed Job Scheduler API","description":"Reliable background job execution across multiple workers.\n\n**Auth** — send `Authorization: Bearer <jwt>` (dashboard) or `X-API-Key` (services).\n\n**Pagination** — cursor-based. Offset pagination is unsafe on a table taking thousands of inserts a minute: rows shift between pages, so callers see duplicates and miss records.\n\n**Idempotency** — send `Idempotency-Key` on job creation. A retried request returns the original job with `200` and `X-Idempotent-Replay: true`.","version":"1.0","contact":{}},"tags":[],"servers":[],"components":{"securitySchemes":{"bearer":{"scheme":"bearer","bearerFormat":"JWT","type":"http"},"api-key":{"type":"apiKey","in":"header","name":"X-API-Key"}},"schemas":{"RegisterDto":{"type":"object","properties":{"email":{"type":"string"},"password":{"type":"string","minLength":12},"name":{"type":"string"},"org_name":{"type":"string"}},"required":["email","password","name","org_name"]},"LoginDto":{"type":"object","properties":{"email":{"type":"string"},"password":{"type":"string"}},"required":["email","password"]},"CreateProjectDto":{"type":"object","properties":{"org_id":{"type":"string"},"name":{"type":"string"},"slug":{"type":"string"},"description":{"type":"string"}},"required":["org_id","name","slug"]},"UpdateProjectDto":{"type":"object","properties":{"name":{"type":"string"},"description":{"type":"string"}}},"CreateRetryPolicyDto":{"type":"object","properties":{"name":{"type":"string"},"strategy":{"type":"string","enum":["FIXED","LINEAR","EXPONENTIAL"]},"max_attempts":{"type":"number"},"base_delay_ms":{"type":"number"},"max_delay_ms":{"type":"number"},"jitter_pct":{"type":"number","default":10},"retry_on_error_codes":{"type":"array","items":{"type":"string"}}},"required":["name","strategy","max_attempts","base_delay_ms","max_delay_ms"]},"CreateApiKeyDto":{"type":"object","properties":{"name":{"type":"string"},"scopes":{"default":["jobs:read","jobs:write"],"type":"array","items":{"type":"string"}}},"required":["name"]},"CreateQueueDto":{"type":"object","properties":{"name":{"type":"string","example":"email-notifications"},"description":{"type":"string"},"default_priority":{"type":"number","minimum":0,"maximum":255,"default":100},"max_concurrency":{"type":"object","description":"Global cap on concurrent executions for this queue. null = unlimited."},"retry_policy_id":{"type":"string"},"visibility_timeout_ms":{"type":"number","minimum":45000,"description":"Lease duration. Must exceed WORKER_TIMEOUT_MS so a worker is declared dead before its jobs are reclaimed."},"default_job_timeout_ms":{"type":"number"},"dlq_enabled":{"type":"boolean","default":true},"retention_days":{"type":"number","description":"Auto-purge terminal jobs after this many days."}},"required":["name","retry_policy_id"]},"UpdateQueueDto":{"type":"object","properties":{"name":{"type":"string"},"description":{"type":"string"},"default_priority":{"type":"number","minimum":0,"maximum":255},"max_concurrency":{"type":"object","description":"null = unlimited."},"retry_policy_id":{"type":"string"},"visibility_timeout_ms":{"type":"number","minimum":45000},"default_job_timeout_ms":{"type":"number"},"dlq_enabled":{"type":"boolean"},"retention_days":{"type":"number"}}},"PauseDto":{"type":"object","properties":{"reason":{"type":"string"}}},"CreateJobDto":{"type":"object","properties":{"handler":{"type":"string","example":"http_request","description":"A registered handler name."},"payload":{"type":"object","description":"Handler input. Validated against the handler schema."},"metadata":{"type":"object","description":"Caller-defined tags. Not passed to the handler."},"priority":{"type":"object","description":"0-255 (higher runs sooner) or a label: CRITICAL, HIGH, NORMAL, LOW, BULK.","example":150},"run_at":{"type":"string","description":"Run at this instant. Mutually exclusive with delay_seconds. Omit both to run now."},"delay_seconds":{"type":"number","description":"Run this many seconds from now."},"max_attempts":{"type":"number","description":"Overrides the queue retry policy for this job only."},"timeout_ms":{"type":"number","description":"Wall-clock limit for one attempt."},"idempotency_key":{"type":"string","description":"Opt-in de-duplication, unique per queue. Re-POSTing the same key returns the existing job with 200 instead of creating a second."},"allow_when_paused":{"type":"boolean","description":"Queue the job even if the queue is paused."}},"required":["handler"]},"JobResponse":{"type":"object","properties":{"id":{"type":"string"},"queue_id":{"type":"string"},"status":{"type":"string"},"handler":{"type":"string"},"priority":{"type":"number"},"attempt_count":{"type":"number"},"max_attempts":{"type":"number"},"run_at":{"type":"string"},"started_at":{"type":"object","nullable":true},"finished_at":{"type":"object","nullable":true},"last_error_code":{"type":"object","nullable":true},"last_error_message":{"type":"object","nullable":true},"created_at":{"type":"string"}},"required":["id","queue_id","status","handler","priority","attempt_count","max_attempts","run_at","started_at","finished_at","last_error_code","last_error_message","created_at"]},"CreateBatchDto":{"type":"object","properties":{"jobs":{"maxItems":1000,"type":"array","items":{"$ref":"#/components/schemas/CreateJobDto"}},"stop_on_error":{"type":"boolean","description":"All-or-nothing. When false (default), valid jobs commit and failures are reported per index."}},"required":["jobs"]},"Object":{"type":"object","properties":{}},"ValidateCronDto":{"type":"object","properties":{"cron_expression":{"type":"string"},"timezone":{"type":"string","default":"UTC"}},"required":["cron_expression"]},"CreateScheduleDto":{"type":"object","properties":{"queue_id":{"type":"string"},"name":{"type":"string"},"cron_expression":{"type":"string","example":"0 9 * * *"},"timezone":{"type":"string","default":"UTC","description":"IANA name, e.g. Asia/Kolkata."},"handler":{"type":"string"},"payload":{"type":"object"},"priority":{"type":"number"},"max_attempts":{"type":"number"},"timeout_ms":{"type":"number"},"misfire_policy":{"type":"string","enum":["SKIP","FIRE_ONCE","BACKFILL"],"default":"SKIP"},"start_at":{"type":"string"},"end_at":{"type":"string"}},"required":["queue_id","name","cron_expression","handler"]},"UpdateScheduleDto":{"type":"object","properties":{"cron_expression":{"type":"string"},"timezone":{"type":"string"},"payload":{"type":"object"},"priority":{"type":"number"}}},"ReplayDto":{"type":"object","properties":{"payload":{"type":"object","description":"Corrected payload. Defaults to the snapshot."},"queue_id":{"type":"string","description":"Send the replay to a different queue."}}},"DiscardDto":{"type":"object","properties":{"note":{"type":"string"}}}}}}