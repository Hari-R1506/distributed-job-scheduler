{
  "name": "distributed-job-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "A production-inspired distributed job scheduling platform built on PostgreSQL.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:generate": "npm run generate -w @djs/db",
    "db:migrate": "npm run migrate -w @djs/db",
    "db:reset": "npm run reset -w @djs/db",
    "db:studio": "npm run studio -w @djs/db",
    "seed": "tsx tools/seed.ts",
    "load": "tsx tools/load-generator.ts",
    "dev:api": "npm run dev -w @djs/api",
    "dev:worker": "npm run dev -w @djs/worker",
    "dev:scheduler": "npm run dev -w @djs/scheduler",
    "dev:web": "npm run dev -w @djs/web",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:race": "vitest run --project concurrency",
    "test:race:repeat": "vitest run --project concurrency --repeat 20",
    "test:watch": "vitest --project unit"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "docx": "^9.7.1",
    "prettier": "^3.4.2",
    "testcontainers": "^12.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "ssh2@1.17.0": true,
    "argon2@0.45.1": true,
    "@scarf/scarf": false,
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
