# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and adjust. `make up` reads this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=djs
POSTGRES_PASSWORD=djs_dev_password
POSTGRES_DB=job_scheduler
POSTGRES_PORT=5432

# Host-side URL (running services with `npm run dev:*` outside Docker)
DATABASE_URL=postgresql://djs:djs_dev_password@localhost:5432/job_scheduler?schema=public

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Access tokens are short-lived and held in memory by the SPA.
# Refresh tokens are rotated and stored in an httpOnly cookie. See ARCHITECTURE.md §29.6.
JWT_ACCESS_SECRET=change-me-in-production-min-32-chars-long
JWT_REFRESH_SECRET=change-me-too-in-production-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:5173

# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_NAME=worker-local
# Number of jobs this process runs at once. A local resource limit, NOT the
# per-queue concurrency cap (which is enforced in the DB). See ARCHITECTURE.md §8.3.
WORKER_CONCURRENCY=10
# Comma-separated queue names, or `*` for every queue in every subscribed project.
WORKER_QUEUES=*
WORKER_POLL_MIN_MS=250
WORKER_POLL_MAX_MS=2000
WORKER_HEARTBEAT_MS=5000
WORKER_SHUTDOWN_GRACE_MS=30000
WORKER_HTTP_PORT=3100

# ── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_TICK_MS=1000
SCHEDULER_PROMOTE_BATCH=500
SCHEDULER_REAP_BATCH=200
# A worker silent for longer than this is marked DEAD.
# INVARIANT: worker_timeout > 2 x heartbeat, and queue lease > worker_timeout.
# Validated at boot — see ARCHITECTURE.md §14.1.
WORKER_TIMEOUT_MS=30000
SCHEDULER_HTTP_PORT=3200

# ── Retention (background purge) ─────────────────────────────────────────────
RETENTION_JOB_LOGS_DAYS=7
RETENTION_HEARTBEATS_HOURS=24
RETENTION_DEAD_WORKERS_DAYS=7

# ── Web ──────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api/v1

# ── Bonus: AI failure summaries (optional; feature is skipped when unset) ─────
ANTHROPIC_API_KEY=
AI_SUMMARY_MODEL=claude-sonnet-5
